{
    "permissions": {
        "defaultMode": "default",
        "allow": [
            "Bash(dooservice status)",
            "Bash(dooservice logs:*)",
            "Bash(dooservice storage)",
            "Bash(ls:*)",
            "mcp__dooservice__odoo_read",
            "mcp__dooservice__odoo_find",
            "mcp__dooservice__odoo_logs"
        ],
        "ask": [
            "Bash(dooservice shell:*)",
            "Bash(odoo-bin:*)",
            "Bash(python3:*)",
            "mcp__dooservice__odoo_write",
            "mcp__dooservice__odoo_settings"
        ],
        "deny": [
            "Edit",
            "Write",
            "NotebookEdit",
            "Read(/run/dooservice/**)",
            "Bash(*/run/dooservice*)",
            "Bash(*write-credentials*)",
            "mcp__dooservice__module_install",
            "mcp__dooservice__module_update"
        ]
    }
}
