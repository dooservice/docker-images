{
    "skipDangerousModePermissionPrompt": true,
    "permissions": {
        "defaultMode": "bypassPermissions",
        "allow": [
            "Bash(odoo-bin:*)",
            "Bash(dooservice:*)",
            "Bash(python3:*)",
            "Bash(sed *)",
            "mcp__dooservice"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "rtk hook claude"
                    }
                ]
            }
        ]
    }
}
