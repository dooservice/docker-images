{
    "permission": {
        "edit": "deny",
        "read": {
            "*": "allow",
            "/run/dooservice/*": "deny"
        },
        "external_directory": {
            "/run/dooservice/*": "deny"
        },
        "bash": {
            "*": "ask",
            "psql*": "allow",
            "dooservice status": "allow",
            "dooservice logs*": "allow",
            "dooservice storage": "allow",
            "ls*": "allow",
            "echo*": "allow",
            "*/run/dooservice*": "deny",
            "*write-credentials*": "deny"
        },
        "webfetch": "allow",
        "dooservice_odoo_write": "ask",
        "dooservice_odoo_settings": "ask"
    },
    "tools": {
        "dooservice_module_*": false
    }
}
