{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        "/opt/dooservice/ai/AGENTS.md"
    ],
    "lsp": false,
    "permission": {
        "edit": "deny",
        "read": {
            "*": "allow",
            "/run/dooservice/*": "deny"
        },
        "external_directory": {
            "/run/dooservice/*": "deny"
        },
        "bash": {
            "*": "ask",
            "psql*": "allow",
            "dooservice status": "allow",
            "dooservice logs*": "allow",
            "dooservice storage": "allow",
            "ls*": "allow",
            "echo*": "allow",
            "*/run/dooservice*": "deny",
            "*write-credentials*": "deny"
        },
        "webfetch": "allow",
        "dooservice_odoo_write": "ask",
        "dooservice_odoo_settings": "ask"
    },
    "autoupdate": false,
    "mcp": {
        "dooservice": {
            "type": "local",
            "command": [
                "python3",
                "/opt/dooservice/mcp/server.py"
            ],
            "enabled": true
        }
    },
    "tools": {
        "dooservice_module_*": false
    }
}
