{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "skipDangerousModePermissionPrompt": true,
    "permissions": {
        "defaultMode": "bypassPermissions",
        "deny": [
            "WebFetch",
            "WebSearch",
            "Bash(git commit:*)",
            "Bash(git push:*)",
            "Bash(git remote:*)",
            "Bash(curl:*)",
            "Bash(wget:*)",
            "Bash(env:*)",
            "Bash(printenv:*)"
        ]
    },
    "env": {
        "DISABLE_AUTOUPDATER": "1"
    },
    "attribution": {
        "commit": "",
        "pr": ""
    }
}
