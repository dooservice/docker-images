{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "skipDangerousModePermissionPrompt": true,
    "permissions": {
        "defaultMode": "bypassPermissions",
        "allow": [
            "Read(/opt/dooservice/ai/**)",
            "Read(/usr/lib/python3/dist-packages/odoo/**)",
            "Bash(odoo-bin:*)",
            "Bash(dooservice:*)",
            "Bash(psql:*)",
            "Bash(python3:*)",
            "Bash(echo *)",
            "Bash(echo)",
            "Bash(sed *)"
        ],
        "deny": [
            "Edit",
            "Write",
            "NotebookEdit"
        ]
    },
    "env": {
        "DISABLE_AUTOUPDATER": "1"
    },
    "attribution": {
        "commit": "",
        "pr": ""
    },
    "tui": "fullscreen",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "rtk hook claude"
                    }
                ]
            }
        ]
    }
}
