{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "skipDangerousModePermissionPrompt": true,
    "permissions": {
        "defaultMode": "bypassPermissions",
        "allow": [
            "Read(/opt/dooservice/ai/**)",
            "Read(/usr/lib/python3/dist-packages/odoo/**)",
            "Read(/mnt/addons/**)",
            "Edit(/mnt/addons/**)",
            "Bash(odoo-bin:*)",
            "Bash(dooservice:*)",
            "Bash(psql:*)",
            "Bash(python3:*)",
            "Bash(git:*)",
            "Bash(echo *)",
            "Bash(echo)",
            "Bash(sed *)"
        ]
    },
    "env": {
        "DISABLE_AUTOUPDATER": "1"
    },
    "tui": "fullscreen",
    "hooks": {
        "PreToolUse": [{
            "matcher": "Bash",
            "hooks": [{
                "type": "command",
                "command": "rtk hook claude"
            }]
        }]
    }
}
