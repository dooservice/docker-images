#!/usr/bin/env python3
"""Claude Code, set up for the environment this console belongs to.

The binary in /opt/ai is Claude Code as Anthropic ships it; everything dooservice adds is
arguments and a few files. The project is the environment's addons, or the session's
home when there is no repository and the agent only configures; the settings, the
instructions and the skills for that mode come from /opt/dooservice/ai and cannot be
changed from here — the instructions reach it as `~/.claude/CLAUDE.md`, which imports them,
and each person signs in with their own account — the login lives in this session's home
and is gone when the session ends.

The conversations are kept: `~/.claude/projects` is the person's own directory for this
environment, which the platform mounts into their consoles and nobody else's, and the
last one is picked up unless a new one was asked for.
"""

import glob
import json
import os
import subprocess
import sys

from dooservice_ai import AiSession, language_rule

HOME = os.path.expanduser("~")
CLAUDE_DIR = os.path.join(HOME, ".claude")
RTK_MARKER = os.path.join(CLAUDE_DIR, "RTK.md")
LOG = "/tmp/dooservice-ai.log"
PASSTHROUGH = ("agents", "auth", "doctor", "install", "mcp", "plugin", "setup-token", "update", "upgrade")

session = AiSession("claude")
session.begin()
mode = session.mode
history = os.path.join(CLAUDE_DIR, "projects", mode.project.replace("/", "-"))
kept = os.environ.get("DOOSERVICE_AI_HISTORY", "")
resume = os.environ.get("DOOSERVICE_AI_RESUME", "1") != "0"

os.makedirs(CLAUDE_DIR, exist_ok=True)
mode.claude_memory(CLAUDE_DIR)
mode.link_skills(os.path.join(CLAUDE_DIR, "skills"))
projects = os.path.join(CLAUDE_DIR, "projects")
if kept and not os.path.islink(projects) and not os.path.exists(projects):
    os.symlink(os.path.join(kept, "claude"), projects)
if not os.path.exists(RTK_MARKER):
    try:
        with open(LOG, "a") as log:
            subprocess.run(["rtk", "init", "-g", "--auto-patch"], input="n\n", text=True, stdout=log, stderr=log, check=True)
    except (OSError, subprocess.CalledProcessError):
        open(RTK_MARKER, "a").close()

config_path = os.path.join(HOME, ".claude.json")
if not os.path.exists(config_path):
    with open(config_path, "w") as config:
        json.dump({
            "hasTrustDialogAccepted": True,
            "theme": "dark",
            "projects": {mode.project: {"hasTrustDialogAccepted": True, "allowedTools": []}},
        }, config)

os.chdir(mode.project)
args = sys.argv[1:]
if not args or args[0] not in PASSTHROUGH:
    version = os.environ.get("ODOO_VERSION", "")
    environment = os.environ.get("DOOSERVICE_ENVIRONMENT", "")
    project = os.environ.get("DOOSERVICE_PROJECT", "")
    args += [
        f"--settings={mode.claude_settings}",
        "--add-dir=/opt/dooservice/ai/",
        "--add-dir=/usr/lib/python3/dist-packages/odoo/",
        f"--append-system-prompt=Odoo version is {version}. This is the {environment} environment of the "
        f"{project} project on the dooservice platform, in {mode.name} mode. {language_rule()}",
    ]
    if resume and glob.glob(os.path.join(history, "*.jsonl")):
        args.append("--continue")

session.execute(["/opt/ai/claude", *args], "Claude Code")
