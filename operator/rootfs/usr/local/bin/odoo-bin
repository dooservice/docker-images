#!/usr/bin/env python3
"""`odoo` with this environment's database already wired in.

The same idea as the wrapper on odoo.sh: whoever calls it — a person or an agent — never
passes the database, its host or the addons path, and cannot point it at another
database by mistake. The password is not on the command line: libpq reads PGPASSWORD
from the environment, so it never shows up in `ps`.

No HTTP by default. This container is not the one serving the environment; it only
installs, updates, tests and opens shells against the same database.

Without a repository, no other addons path is accepted: a
module installed from anywhere else would be in the database and missing from the
environment's Odoo, which would then fail to load it.
"""

import os
import sys

REAL_ODOO = "/usr/bin/odoo"
DATABASE_COMMANDS = ("server", "shell")


def odoo_arguments(command, args):
    injected = []
    if command is None or command in DATABASE_COMMANDS:
        database = os.environ["PGDATABASE"]
        injected = [
            "--db_host", os.environ["PGHOST"],
            "--db_port", os.environ.get("PGPORT", "5432"),
            "--db_user", os.environ["PGUSER"],
            "--database", database,
            f"--db-filter=^{database}$",
            "--no-database-list",
            "--data-dir", "/var/lib/odoo",
            "--workers=0",
        ]
        if not any(arg.startswith("--db_maxconn") for arg in args):
            injected.append("--db_maxconn=4")
        if not any(arg.startswith(("--http-port", "--http-interface")) for arg in args):
            injected.append("--no-http")
    base = [f"--addons-path={os.environ['ADDONS_PATH']}"] if os.environ.get("ADDONS_PATH") else []
    leading = [command] if command else []
    return leading + base + args + injected


argv = sys.argv[1:]
no_repository = not os.path.isdir("/mnt/addons/.git")
if no_repository and any(arg.startswith("--addons-path") for arg in argv):
    sys.stderr.write(
        "This project has no repository: only the modules the environment already has can be installed.\n"
        "Link a repository to the project to develop modules of its own.\n"
    )
    sys.exit(2)
command = argv[0] if argv and not argv[0].startswith("-") else None
rest = argv[1:] if command else argv
os.execv(REAL_ODOO, [REAL_ODOO, *odoo_arguments(command, rest)])
